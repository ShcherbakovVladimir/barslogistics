{
  "name": "bars-logistics",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "build:embed": "vite build --mode embed",
    "build:all": "npm run build && npm run build:embed && bash scripts/merge-portal-embed.sh",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:migrate": "tsx deploy/apply-postgres-migrations.ts",
    "db:rollback": "tsx deploy/rollback-migration.ts",
    "db:restore": "tsx deploy/restore-backup.ts",
    "db:fix-ownership": "bash deploy/fix-db-ownership.sh",
    "import:sites": "tsx deploy/import-sites-from-csv.ts",
    "generate:sites-seed": "tsx deploy/generate-sites-seed-sql.ts",
    "dedup:factories": "tsx deploy/dedup-factories.ts",
    "import:our-sites": "tsx deploy/import-our-sites.ts",
    "import:rzd-analytics": "tsx deploy/import-rzd-analytics.ts",
    "import:internal-shipments": "tsx deploy/import-internal-shipments.ts",
    "regeocode:import-counterparties": "tsx deploy/regeocode-import-counterparties.ts",
    "test:kladr": "tsx deploy/test-kladr.ts",
    "import:kladr": "tsx deploy/download-kladr.ts",
    "geocode:rzd-stations": "tsx deploy/geocode-rzd-stations.ts",
    "apply:rzd-station-overrides": "tsx deploy/apply-rzd-station-overrides.ts",
    "import:sites:prod": "bash deploy/import-sites.sh",
    "generate:vapid": "web-push generate-vapid-keys"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/leaflet": "^1.9.21",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-redux": "^9.3.0",
    "smtp-server": "^3.19.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "workbox-window": "^7.4.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.2.3"
  }
}
