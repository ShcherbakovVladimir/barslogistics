# Production environment (generated by deploy/deploy.sh)
NODE_ENV=production
PORT=3000
APP_URL=https://barslogistics.example.com
# Used in registration/password-reset email links (falls back to APP_URL)
# PUBLIC_BASE_URL=https://barslogistics.example.com
DATABASE_URL=postgresql://barslogistics:CHANGE_ME@127.0.0.1:5432/barslogistics
JWT_SECRET=CHANGE_ME_MIN_16_CHARS_LONG
# Required for seed/sync-users (min 12 characters). deploy.sh generates a random value.
DEFAULT_USER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Demo seed (factories + shipments with fake GPS). Off by default — use CSV/import in production.
SEED_DEMO_DATA=false
BACKUP_DIR=/opt/barslogistics/data/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=30
# BACKUP_SCHEDULER_ENABLED=true
# PG_DUMP_PATH=/usr/bin/pg_dump
# PSQL_PATH=/usr/bin/psql
# KLADR: можно настроить в админке → Геокодирование (рекомендуется)
# или через env (fallback, если в БД пусто):
# KLADR_API_TOKEN=your_token
# KLADR_API_PLAN=paid
# KLADR_API_URL=http://kladr-api.com/api.php
# KLADR_DATA_DIR=/opt/barslogistics/data/kladr

# Internal chat — message attachments stored on disk (Ubuntu path)
# CHAT_FILES_DIR=/opt/barslogistics/data/chat-files
# CHAT_MAX_FILE_BYTES=20971520

# Task documents — attachments for Kanban tasks (Ubuntu path, mode 0640)
# TASK_FILES_DIR=/opt/barslogistics/data/task-files
# TASK_MAX_FILE_BYTES=20971520

# Shipment / transport documents (ТТН, CMR, invoices) — Ubuntu path, mode 0640
# SHIPMENT_FILES_DIR=/opt/barslogistics/data/shipment-files
# SHIPMENT_MAX_FILE_BYTES=20971520

# User profile avatars — Ubuntu path, mode 0640
# AVATAR_FILES_DIR=/opt/barslogistics/data/avatars
# AVATAR_MAX_FILE_BYTES=2097152

# Transport directory photos — Ubuntu path, mode 0640
# TRANSPORT_FILES_DIR=/opt/barslogistics/data/transport
# TRANSPORT_MAX_FILE_BYTES=20971520

# Web Push (VAPID) — offline chat notifications when browser is closed
# Generate keys: npm run generate:vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# --- Bars portal embed (portal.almaz-t.ru/bars/logistics/) ---
# Validate AD/portal JWT issued by requestchainrestproxy
AUTH_VALIDATE_URL=https://requestchainrestproxy.almaz-t.ru/v1/auth/validate
# AD login for standalone tab «Портал» (defaults from AUTH_VALIDATE_URL → /v1/authenticate/ad)
# AUTH_AD_URL=https://requestchainrestproxy.almaz-t.ru/v1/authenticate/ad
# Comma-separated browser origins allowed to call the API (CORS). Required in production.
CORS_ORIGINS=https://portal.almaz-t.ru,https://barslogistics.almaz-t.ru
# Allow http://192.168.x.x / 10.x.x.x origins (phones on Wi‑Fi, VPN). Off by default in production.
# CORS_ALLOW_LAN=true
# Security — rate limits (per IP)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# REGISTER_RATE_LIMIT_MAX=8
# FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
# FORGOT_PASSWORD_RATE_LIMIT_MAX=10
# WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# WEBHOOK_RATE_LIMIT_MAX=120
# CSP extras (production): comma-separated URLs
# CSP_CONNECT_SRC=https://requestchainrestproxy.almaz-t.ru,https://nominatim.openstreetmap.org
# CSP_FRAME_ANCESTORS=https://portal.almaz-t.ru
# Local dev only — Vite proxy target for portal auth (vite.config.ts)
# VITE_PORTAL_PROXY_TARGET=https://portal.almaz-t.ru
# Optional: map portal role → BarsLogistics role (JSON)
# PORTAL_ROLE_MAP={"user":"local_employee","leader":"key_person","admin":"admin"}
# PORTAL_DEFAULT_ROLE=local_employee

# Vite client — standalone build uses relative /api (same host as the page).
# Portal embed sets absolute API in .env.embed (vite build --mode embed).
# VITE_API_BASE=https://barslogistics.almaz-t.ru/api
# Local portal mock (optional, .env.local — do not commit JWT):
# VITE_DEV_JWT=eyJ...
